{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelfusion:artifact-extension:higress-conversion.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "converter_version", "info", "phase", "priority", "global_schema_path", "route_schema_path", "external_resources", "annotations", "source_spec_digest"],
  "properties": {
    "schema_version": {"const": "higress-conversion.v1"},
    "converter_version": {"const": "higress-conversion.v1"},
    "info": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "urn:modelfusion:contracts:v1:package-descriptor#/$defs/PluginName"},
        "version": {"$ref": "urn:modelfusion:contracts:v1:package-descriptor#/$defs/PluginVersion"}
      }
    },
    "phase": {"enum": ["default", "UNSPECIFIED_PHASE", "AUTHN", "AUTHZ", "STATS"]},
    "priority": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
    "global_schema_path": {"const": "config.schema.json"},
    "route_schema_path": {"enum": [null, "route.schema.json"]},
    "ai_routing": {"$ref": "#/$defs/AiRouting"},
    "source_spec_digest": {"$ref": "urn:modelfusion:contracts:v1:common#/$defs/Digest"},
    "external_resources": {
      "type": "object", "additionalProperties": false, "required": ["global", "route"],
      "properties": {"global": {"$ref": "#/$defs/ScopeExternal"}, "route": {"$ref": "#/$defs/ScopeExternal"}}
    },
    "annotations": {
      "type": "object", "additionalProperties": false, "required": ["global", "route"],
      "properties": {"global": {"$ref": "#/$defs/ScopeAnnotations"}, "route": {"$ref": "#/$defs/ScopeAnnotations"}}
    }
  },
  "$defs": {
    "ExternalResource": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "registryType", "domainPath", "portPath"],
      "properties": {
        "kind": {"enum": ["redis", "http", "http-callout"]},
        "registryType": {"enum": ["dns", "static"]},
        "domainPath": {"type": "string", "minLength": 1},
        "portPath": {"type": "string", "minLength": 1},
        "projectedNamePath": {"type": "string", "minLength": 1},
        "protocol": {"const": "http"}
      }
    },
    "ScopeExternal": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "x-higress-external-resource": {"$ref": "#/$defs/ExternalResource"},
        "x-higress-external-resources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ExternalResource"}},
        "externalResources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ExternalResource"}}
      },
      "not": {"required": ["x-higress-external-resource", "x-higress-external-resources"]}
    },
    "ScopeAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "x-title-i18n": {"type": "object", "additionalProperties": {"type": "string"}},
          "x-description-i18n": {"type": "object", "additionalProperties": {"type": "string"}},
          "x-scope": {"enum": ["GLOBAL", "RULE", "ALL"]},
          "x-sensitive": {"type": "boolean"},
          "format": {"const": "password"}
        }
      }
    },
    "AiRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumPluginVersion"
      ],
      "properties": {
        "minimumPluginVersion": {
          "$ref": "urn:modelfusion:contracts:v1:package-descriptor#/$defs/PluginVersion"
        },
        "protocolModes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "auto",
              "passthrough"
            ]
          }
        },
        "pathScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "legacy_suffixes",
              "bound_target"
            ]
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AiRoutingAdapter"
          }
        }
      }
    },
    "AiRoutingAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "capability",
        "operations",
        "usageProfile",
        "minimumPluginVersion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AiRoutingOperation"
          }
        },
        "usageProfile": {
          "type": "string",
          "minLength": 1
        },
        "minimumPluginVersion": {
          "$ref": "urn:modelfusion:contracts:v1:package-descriptor#/$defs/PluginVersion"
        }
      }
    },
    "AiRoutingOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clientMethod",
        "clientPath",
        "upstreamMethod",
        "upstreamPath"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "clientMethod": {
          "type": "string",
          "minLength": 1
        },
        "clientPath": {
          "type": "string",
          "minLength": 1
        },
        "upstreamMethod": {
          "type": "string",
          "minLength": 1
        },
        "upstreamPath": {
          "type": "string",
          "minLength": 1
        },
        "requestTransform": {
          "type": [
            "string",
            "null"
          ]
        },
        "responseTransform": {
          "type": [
            "string",
            "null"
          ]
        },
        "streamingBehavior": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
