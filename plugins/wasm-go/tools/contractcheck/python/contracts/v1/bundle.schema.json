{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelfusion:contracts:v1:bundle",
  "type": "object",
  "properties": {
    "bundle_format_version": {
      "const": "d0-bundle-v1"
    },
    "bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "producer_project": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "schema_dialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_id": {
            "type": "string",
            "pattern": "^urn:[^\\s#]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_./-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "schema_id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_./-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "validation": {
            "$ref": "urn:modelfusion:contracts:v1:fixture-validation"
          },
          "asset_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "expected": {
            "type": "object",
            "properties": {
              "verdict": {
                "enum": [
                  "accept",
                  "reject"
                ]
              },
              "error_code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "verdict",
              "error_code"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "const": "accept"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "error_code": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "error_code": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "required": [
          "case_id",
          "path",
          "sha256",
          "validation",
          "asset_refs",
          "expected"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_./-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "asset_id",
          "path",
          "sha256",
          "media_type"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "bundle_format_version",
    "bundle_version",
    "producer_project",
    "source_revision",
    "schema_dialect",
    "entries",
    "fixtures",
    "assets"
  ],
  "additionalProperties": false
}
